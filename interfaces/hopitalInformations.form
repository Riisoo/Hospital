            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="Un syst&#xe8;me de gestion hospitali&#xe8;re  est un &#xe9;l&#xe9;ment de l&apos;informatique de sant&#xe9; qui se concentre principalement &#xa;sur les besoins administratifs des h&#xf4;pitaux. ... Ces syst&#xe8;mes am&#xe9;liorent la capacit&#xe9; des professionnels de la sant&#xe9; &#xa;&#xe0; coordonner les soins en fournissant les informations de sant&#xe9; d&apos;un patient et l&apos;historique de ses visites au &#xa;moment et &#xe0; l&apos;endroit o&#xf9; cela est n&#xe9;cessaire."/>
          </Properties>
        </Component>
      </SubComponents>
